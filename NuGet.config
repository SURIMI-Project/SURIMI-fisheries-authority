<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="github-Official-EwE" value="https://nuget.pkg.github.com/Official-EwE/index.json" />
        <add key="BSR" value="https://buf.build/gen/nuget/index.json" protocolVersion="3" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <!-- Force these packages to come only from GitHub -->
        <packageSource key="github-Official-EwE">
            <package pattern="SURIMI.*" />
            <package pattern="Eii.*" />
        </packageSource>
        <packageSource key="BSR">
            <package pattern="BSR.*" />
        </packageSource>
        <!-- Everything else can come from nuget.org -->
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>