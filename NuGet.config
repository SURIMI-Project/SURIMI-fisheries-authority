<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSourceMapping>
        <!-- Force these packages to come only from GitHub -->
        <packageSource key="github-Official-EwE">
            <package pattern="Eii.*" />
        </packageSource>
        <packageSource key="github-Surimi-project">
            <package pattern="SURIMI.*" />
        </packageSource>
        <packageSource key="BSR">
            <package pattern="BSR.*" />
        </packageSource>
        <!-- Everything else can come from nuget.org -->
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>