<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SURIMI_fisheries_authority</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>3e27b886-c5a2-46cb-b03f-1918a544dcd2</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BSR.Surimi.Surimi-Protocol.Grpc.Csharp" Version="1.84.10001.93+d8eedf2f6694" />
        <PackageReference Include="Eii.BlobStore.S3" Version="1.0.*" />
        <PackageReference Include="Eii.Ecopath.EwECore" Version="6.7.94-MSE.2" />
        <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.80.0" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
        <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
        <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
        <PackageReference Include="Grpc.StatusProto" Version="2.71.0" />
        <PackageReference Include="SURIMI.Common" Version="1.0.*" />
        <PackageReference Include="SURIMI.Datamodel" Version="3.0.*" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Includes\*.csv" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Includes\aegean_sea\" />
      <Folder Include="Includes\anchovy_bay\" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Includes\northwestern_med\northwestern_med_quotashare.csv">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Includes\northwestern_med\northwestern_med_initial_quota.csv">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Includes\northwestern_med\northwestern_med_recruitment.csv">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
