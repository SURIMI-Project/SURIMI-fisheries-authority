{
    "profiles": {
        "http": {
            "commandName": "Project",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotnetRunMessages": true,
            "applicationUrl": "http://localhost:5493"
        },
        "https": {
            "commandName": "Project",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotnetRunMessages": true,
            "applicationUrl": "https://localhost:7244;http://localhost:5493"
        },
        "Container (Dockerfile)": {
            "commandName": "Docker",
            "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
            "environmentVariables": {
                "ASPNETCORE_HTTPS_PORTS": "7244",
                "ASPNETCORE_HTTP_PORTS": "5493"
            },
            "publishAllPorts": true,
            "useSSL": true
        }
    },
    "$schema": "http://json.schemastore.org/launchsettings.json"
}